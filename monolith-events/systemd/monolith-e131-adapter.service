[Unit]
Description=Monolith QLC+ E1.31 to OpenRGB adapter
Wants=openrgb-sdk.service monolith-qlcplus.service
After=openrgb-sdk.service monolith-qlcplus.service
Conflicts=monolith-openrgb-sdk-bridge.service

# This unit is intentionally not installed or enabled yet. It replaces the
# direct SDK bridge only after the QLC+ scene engine has a tested baseline.
[Service]
Type=simple
ExecStart=/home/chronic_frolic/server-config/monolith-events/monolithd/target/release/monolithd e131-receiver
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
