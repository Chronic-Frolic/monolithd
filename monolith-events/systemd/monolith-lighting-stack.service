[Unit]
Description=Monolith private QLC+ to Rust to OpenRGB lighting stack
Conflicts=openrgb-sdk.service monolith-openrgb-sdk-bridge.service monolith-qlcplus.service monolith-e131-adapter.service

[Service]
Type=simple
# The QLC+ WebSocket and all E1.31 traffic exist only inside this namespace.
PrivateNetwork=yes
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
ExecStart=/home/chronic_frolic/server-config/monolith-events/systemd/monolith-lighting-stack.sh
Restart=on-failure
# A deliberate stop makes the script exit 143 (SIGTERM); that is not a failure.
SuccessExitStatus=143
RestartSec=2

[Install]
WantedBy=default.target
