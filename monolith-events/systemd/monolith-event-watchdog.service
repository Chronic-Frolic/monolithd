[Unit]
Description=Monolith Event Watchdog
After=monolith-event-controller.service
OnFailure=monolith-rgb-failsafe.service

[Service]
Type=simple
ExecStart=/home/chronic_frolic/.local/share/monolith-events/venv/bin/python /home/chronic_frolic/monolithd/monolith-events/monolith_event_watchdog.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
