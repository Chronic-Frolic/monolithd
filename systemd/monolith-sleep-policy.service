[Unit]
Description=Monolith sleep policy (the machine's suspend authority; see config/sleep.toml)
After=monolith-controller.service

# Reads jobs, input (monolith-input.service), music, remote desktop and streaming
# sessions, and sleep inhibitors; reports in the journal and
# $XDG_RUNTIME_DIR/monolith-events/sleep-policy.json. With suspend = true in
# config/sleep.toml (hot-reloaded) it is the machine's only suspend authority: it shows
# the pre-sleep cue for the last cue_minutes, then runs systemctl suspend. Steam's and
# KDE's own suspend timers must be off.

[Service]
Type=simple
Environment=MONOLITHD_CONFIG_DIR=%h/monolithd/config
ExecStart=%h/monolithd/target/release/monolithd sleep-policy
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
