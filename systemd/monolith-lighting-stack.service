[Unit]
Description=Monolith private QLC+ to Rust to OpenRGB lighting stack
Conflicts=openrgb-sdk.service monolith-openrgb-sdk-bridge.service monolith-qlcplus.service monolith-e131-adapter.service

[Service]
Environment=MONOLITHD_CONFIG_DIR=%h/monolithd/config
Type=simple
# The QLC+ WebSocket and all E1.31 traffic exist only inside this namespace.
PrivateNetwork=yes
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
ExecStart=%h/monolithd/systemd/monolith-lighting-stack.sh
Restart=on-failure
# Signal only the script on stop. It exits 0 for that deliberate stop and takes its children
# down itself, so a child dying on its own can never be mistaken for a stop.
KillMode=mixed
RestartSec=2

[Install]
WantedBy=default.target
