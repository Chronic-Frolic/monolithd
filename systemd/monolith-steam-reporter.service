[Unit]
Description=Monolith Steam Reporter (Steam downloads as controller jobs)
After=monolith-controller.service
# Five failures within five minutes and systemd stops restarting it; then OnFailure
# raises the Fault. Without the explicit limit RestartSec=5 never reaches the default
# (5 starts in 10 s), so the unit would never count as failed.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=monolith-steam-reporter-failed.service

# Follows Steam's download API through the DevTools port Decky Loader enables
# (127.0.0.1:8080) and reports the app Steam is downloading as a steam:<appid> job.
# A leased job blocks suspend, so this changes when the machine can sleep.

[Service]
Type=simple
ExecStart=/home/chronic_frolic/monolithd/target/release/monolithd steam-reporter
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
