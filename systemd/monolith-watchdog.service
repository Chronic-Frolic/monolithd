[Unit]
Description=Monolith Event Watchdog (controller health and sleep/wake)
# Ordering hint only, not a dependency: this must never start or restart either.
After=monolith-controller.service monolith-lighting-stack.service

[Service]
Type=simple
ExecStart=/home/chronic_frolic/monolithd/target/release/monolithd watchdog
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
