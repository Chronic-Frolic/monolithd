[Unit]
Description=Monolith Event Controller (lighting state and job leases)
After=monolith-lighting-stack.service
Wants=monolith-lighting-stack.service

# The controller runs on the host and talks only to the scene gateway's Unix socket.
# Paths assume the checkout lives at ~/monolithd (%h is the home directory).

[Service]
Environment=MONOLITHD_CONFIG_DIR=%h/monolithd/config
Type=simple
ExecStart=%h/monolithd/target/release/monolithd controller
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
